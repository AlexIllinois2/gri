{
  "name": "gri-ts",
  "version": "1.0.0",
  "description": "Modern GitHub Release app manager — CLI + local Web UI, built with Bun + TypeScript",
  "type": "module",
  "bin": {
    "gri": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:cli": "bun build ./src/index.ts --compile --target=bun-$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m) --outfile dist/gri",
    "build:web": "bun build ./web/index.html --production --outdir dist/web --public-path /",
    "build": "bun run build:cli && bun run build:web"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
